<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Login Test Suite" parallel="tests" thread-count="2" verbose="2">
    <listeners>
        <listener class-name="com.salesforce.framework.listeners.ExecutionListener"/>
    </listeners>
    <test name="Valid Login Tests">
        <classes>
            <class name="com.salesforce.tests.login.LoginTest_Valid"/>
        </classes>
    </test>
    <test name="Invalid Login Tests">
        <classes>
            <class name="com.salesforce.tests.login.LoginTest_Invalid"/>
        </classes>
    </test>
</suite>
