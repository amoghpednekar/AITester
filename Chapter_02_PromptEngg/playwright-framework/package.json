{
  "name": "salesforce-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright framework for Salesforce login page automation",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --project=smoke",
    "test:auth": "playwright test --project=auth",
    "test:mock": "playwright test --project=mock",
    "test:regression": "playwright test --project=regression",
    "typecheck": "tsc --noEmit",
    "playwright:install-ci": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "typescript": "^5.6.0"
  }
}
